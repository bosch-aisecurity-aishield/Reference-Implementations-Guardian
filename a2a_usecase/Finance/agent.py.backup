"""Finance Agent – A2A-compatible LangGraph agent for loan calculations.

This agent handles loan and payment calculations by extracting parameters from
natural language queries and computing results using the Finance MCP tool.

Architecture:
    - Uses LLM to extract loan parameters from natural language
    - Calls Finance MCP server for calculations
    - Summarizes results in customer-friendly format
    - Exposes A2A-compatible endpoints via LangGraph

Available MCP Tools (Auto-loaded from mcp_server.py):
    Basic:
    - calculate_monthly_payment: Single loan scenario calculation
    
    Advanced (NEW):
    - compare_loan_options: Multi-scenario comparison (rates × terms)
    - calculate_affordability: Max price from monthly budget (reverse calculation)
    - get_rate_recommendations: Credit score-based rate guidance
    - calculate_total_cost_comparison: Full breakdown with down payment

Environment Variables:
    OLLAMA_BASE_URL: Ollama server URL (default: http://localhost:11434)
    FINANCE_MODEL: LLM model name (default: qwen2.5-coder)

Launch:
    langgraph dev --config finance_langgraph.json --port 5003
"""

from __future__ import annotations

import asyncio
import json
import logging
import os
import sys
from dataclasses import dataclass, field
from typing import Annotated, Any, Dict, List, Optional
from typing_extensions import TypedDict

from langchain_ollama import ChatOllama
from langgraph.constants import START, END
from langgraph.graph import StateGraph
from langgraph.graph.message import add_messages
from langgraph.types import RetryPolicy
from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client

# ── Logging Setup ────────────────────────────────────────────────────────────

logger = logging.getLogger("FinanceAgent")

# ── Configuration ────────────────────────────────────────────────────────────

OLLAMA_BASE_URL = os.getenv("OLLAMA_BASE_URL", "http://localhost:11434")
FINANCE_MODEL = os.getenv("FINANCE_MODEL", "qwen2.5-coder")

_PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MCP_SERVER_PATH = os.path.join(_PROJECT_ROOT, "finance", "mcp_server.py")


# ── Type Definitions ─────────────────────────────────────────────────────────

class Context(TypedDict):
    """Optional configurable parameters for the Finance Agent."""
    default_rate: Optional[str]


@dataclass
class State:
    """A2A-compatible state for the Finance Agent.
    
    Using 'add_messages' reducer handles appending new messages automatically.
    """
    messages: Annotated[List[Dict[str, Any]], add_messages] = field(default_factory=list)


# ── LLM Setup ────────────────────────────────────────────────────────────────

_llm = ChatOllama(
    model=FINANCE_MODEL,
    base_url=OLLAMA_BASE_URL,
    format="json",
    temperature=0,
)

EXTRACT_PROMPT = """\
You are a finance parameter extractor.

From the user's message, extract the following values for a car loan calculation:
  • price  – vehicle price in dollars (float)
  • rate   – annual interest rate as a percentage (float, default 5.0 if unknown)
  • months – loan term in months (int, default 60 if unknown)

Respond ONLY with JSON:
{ "price": <float>, "rate": <float>, "months": <int> }
"""

SUMMARISE_PROMPT = """\
You are a friendly auto-finance advisor.
The customer asked about a loan and the calculator returned:

{calc_result}

Summarise this clearly for the customer, including the monthly payment
amount and the key terms (price, rate, months).

Respond ONLY with valid JSON:
{{ "message": "<your summary>" }}
"""


# ── Core Agent Logic ─────────────────────────────────────────────────────────

async def _call_mcp(price: float, rate: float, months: int) -> str:
    """Call the Finance MCP server for loan calculation.
    
    Args:
        price: Total vehicle price in dollars
        rate: Annual interest rate as percentage
        months: Loan term in months
        
    Returns:
        Formatted calculation result string
        
    Raises:
        Exception: If MCP server communication fails
    """
    server_params = StdioServerParameters(
        command=sys.executable,
        args=[MCP_SERVER_PATH],
    )

    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            
            result = await session.call_tool(
                "calculate_monthly_payment",
                arguments={"price": price, "rate": rate, "months": months},
            )
            
            if result.content and hasattr(result.content[0], "text"):
                return result.content[0].text
            return str(result)


async def _call_mcp_compare_loans(price: float, rates: List[float], terms: List[int]) -> str:
    """Compare multiple loan scenarios via MCP server.
    
    Args:
        price: Vehicle price in dollars
        rates: List of interest rates to compare
        terms: List of loan terms to compare
        
    Returns:
        Formatted comparison table string
    """
    server_params = StdioServerParameters(
        command=sys.executable,
        args=[MCP_SERVER_PATH],
    )

    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            result = await session.call_tool(
                "compare_loan_options",
                arguments={"price": price, "rates": rates, "terms": terms},
            )
            if result.content and hasattr(result.content[0], "text"):
                return result.content[0].text
            return str(result)


async def _call_mcp_affordability(monthly_budget: float, rate: float, months: int) -> str:
    """Calculate maximum affordable price from monthly budget via MCP server.
    
    Args:
        monthly_budget: Maximum monthly payment customer can afford
        rate: Annual interest rate as percentage
        months: Desired loan term in months
        
    Returns:
        Maximum affordable price and loan details
    """
    server_params = StdioServerParameters(
        command=sys.executable,
        args=[MCP_SERVER_PATH],
    )

    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            result = await session.call_tool(
                "calculate_affordability",
                arguments={"monthly_budget": monthly_budget, "rate": rate, "months": months},
            )
            if result.content and hasattr(result.content[0], "text"):
                return result.content[0].text
            return str(result)


async def _call_mcp_rate_recommendations(credit_score: int = 700) -> str:
    """Get interest rate recommendations based on credit score via MCP server.
    
    Args:
        credit_score: Customer's credit score (300-850)
        
    Returns:
        Estimated rate range and qualification tier
    """
    server_params = StdioServerParameters(
        command=sys.executable,
        args=[MCP_SERVER_PATH],
    )

    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            result = await session.call_tool(
                "get_rate_recommendations",
                arguments={"credit_score": credit_score},
            )
            if result.content and hasattr(result.content[0], "text"):
                return result.content[0].text
            return str(result)


async def _call_mcp_total_cost(price: float, down_payment: float, rate: float, months: int) -> str:
    """Calculate detailed total cost breakdown via MCP server.
    
    Args:
        price: Vehicle price
        down_payment: Initial down payment amount
        rate: Annual interest rate as percentage
        months: Loan term in months
        
    Returns:
        Detailed cost breakdown including down payment
    """
    server_params = StdioServerParameters(
        command=sys.executable,
        args=[MCP_SERVER_PATH],
    )

    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            result = await session.call_tool(
                "calculate_total_cost_comparison",
                arguments={
                    "price": price,
                    "down_payment": down_payment,
                    "rate": rate,
                    "months": months
                },
            )
            if result.content and hasattr(result.content[0], "text"):
                return result.content[0].text
            return str(result)


async def _call_mcp(price: float, rate: float, months: int) -> str:
    """Call the Finance MCP server for loan calculation.
    
    Args:
        price: Total vehicle price in dollars
        rate: Annual interest rate as percentage
        months: Loan term in months
        
    Returns:
        Formatted calculation result string
        
    Raises:
        Exception: If MCP server communication fails
    """
    server_params = StdioServerParameters(
        command=sys.executable,
        args=[MCP_SERVER_PATH],
    )

    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            
            result = await session.call_tool(
                "calculate_monthly_payment",
                arguments={"price": price, "rate": rate, "months": months},
            )
            
            if result.content and hasattr(result.content[0], "text"):
                return result.content[0].text
            return str(result)


async def process_finance_request(state: State) -> Dict[str, Any]:
    """Process finance request by extracting parameters, calculating, and summarizing.
    
    Process Flow:
        1. Extract loan parameters from user's natural language message
        2. Call MCP calculator with extracted parameters
        3. Summarize calculation results in customer-friendly format
    
    Args:
        state: Current conversation state with messages
        runtime: LangGraph runtime with configuration context
        
    Returns:
        Updated state with assistant's response message
    """
    
    # Get the last user message
    if not state.messages:
        return {"messages": []}
        
    latest_message = state.messages[-1]
    user_text = latest_message.content if hasattr(latest_message, "content") else latest_message.get("content", "")

    extract_response = await _llm.ainvoke([
        {"role": "system", "content": EXTRACT_PROMPT},
        {"role": "user", "content": user_text},
    ])

    try:
        params = json.loads(extract_response.content)
    except json.JSONDecodeError:
        params = {"price": 30000, "rate": 5.0, "months": 60}

    price = float(params.get("price", 30000))
    rate = float(params.get("rate", 5.0))
    months = int(params.get("months", 60))

    try:
        calc_result = await asyncio.wait_for(
            _call_mcp(price, rate, months),
            timeout=10.0
        )
        calc_success = True
    except asyncio.TimeoutError:
        calc_result = "The calculation timed out. Please try again."
        calc_success = False
        logger.warning("MCP calculation timed out after 10 seconds")
    except Exception as exc:
        logger.error(f"MCP calculation failed: {exc}")
        calc_result = f"Calculation failed: {str(exc)}"
        calc_success = False

    if calc_success:
        prompt = SUMMARISE_PROMPT.format(calc_result=calc_result)
        summary_response = await _llm.ainvoke([
            {"role": "system", "content": prompt},
            {"role": "user", "content": user_text},
        ])

        try:
            content = json.loads(summary_response.content)
            reply = content.get("message", content.get("summary", str(content)))
        except json.JSONDecodeError:
            reply = summary_response.content
    else:
        reply = calc_result

    return {
        "messages": [
            {"role": "assistant", "content": reply}
        ]
    }


# ── Graph Definition ─────────────────────────────────────────────────────────

finance_retry_policy = RetryPolicy(
    initial_interval=0.5,
    backoff_factor=2.0,
    max_interval=10.0,
    max_attempts=3,
    jitter=True,
)

builder = StateGraph(State, config_schema=Context)

builder.add_node(
    "process_finance_request",
    process_finance_request,
    retry=finance_retry_policy
)

builder.add_edge(START, "process_finance_request")
builder.add_edge("process_finance_request", END)

graph = builder.compile()